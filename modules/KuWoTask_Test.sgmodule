#!name=酷我音乐签到(测试版)
#!desc=酷我音乐自动签到、领金币、抽奖等任务 —— 每分钟触发，仅用于验证 cron 是否生效
#!author=bb
#!homepage=https://360.com/kuwo
#!icon=https://raw.githubusercontent.com/deezertidal/private/main/icons/kuwosvip.png
#!date=2025-12-18
#!arguments=phone:"",ocr:"",notify:true
#!arguments-desc=测试版：cronexp 已改为每分钟触发，验证完请立即关闭本模块。手机号用于Web登录(可留空)，OCR密钥用于验证码识别(可留空)，关闭通知后仅在23点发送汇总

[Script]
酷我音乐签到测试 = type=cron, cronexp="* * * * *", script-path=https://raw.githubusercontent.com/ios151/Rewrite/refs/heads/main/kuwotask.js, timeout=120, argument="[{{{phone}}},{{{ocr}}},{{{notify}}}]"

酷我助手面板测试 = type=http-request, pattern=^https?:\/\/360\.com\/kuwo, script-path=https://raw.githubusercontent.com/ios151/Rewrite/refs/heads/main/kuwotask.js, requires-body=true, timeout=60, argument="[{{{phone}}},{{{ocr}}},{{{notify}}}]"

[MITM]
hostname = %APPEND% 360.com
