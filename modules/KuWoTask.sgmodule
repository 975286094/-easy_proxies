#!name=酷我音乐签到
#!desc=酷我音乐自动签到、领金币、抽奖等任务
#!author=bb
#!homepage=https://360.com/kuwo
#!icon=https://raw.githubusercontent.com/deezertidal/private/main/icons/kuwosvip.png
#!date=2025-12-18
#!arguments=phone:"",ocr:"",notify:true
#!arguments-desc=phone:\n用于Web登录的手机号(可留空)\nocr:\n验证码识别API密钥(可留空)\nnotify:\n关闭后仅在23点发送汇总通知

[Script]
酷我音乐签到 = type=cron, pattern=15 7-23/1 * * *, script-path=https://raw.githubusercontent.com/ios151/Rewrite/refs/heads/main/kuwotask.js, timeout=120, tag=酷我音乐签到, argument="[{phone},{ocr},{notify}]"

酷我助手面板 = type=http-request, pattern=^https?:\/\/360\.com\/kuwo, script-path=https://raw.githubusercontent.com/ios151/Rewrite/refs/heads/main/kuwotask.js, requires-body=true, timeout=60, tag=酷我助手面板, argument="[{phone},{ocr},{notify}]"

[MITM]
hostname = %APPEND% 360.com
